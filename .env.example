# Copy to .env and adjust as needed. The .env file itself is never committed.
# Host port mapped to the container's fixed 52773. Defaults to 52884.
MED_AUDIT_PORT=52884
# Once per data volume on first init, lift only the _SYSTEM first-login password-change requirement (1=on, 0=skip). Local demo only.
MED_AUDIT_DEFAULT_LOGIN_NO_CHANGE=1
# Enable the document-upload vector worker (1=on, 0=disable auto-setup and the worker).
MED_AUDIT_ENABLE_UPLOAD_WORKER=1
